# Copiá este archivo a  .env.local  y completá con tus datos reales.
# (.env.local está gitignored — no lo subas.)

# ---- Auth ----
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- SQL Server (Azure) — AdelanteSBX ----
# lib/db.ts acepta DB_* (base) y SQL_* (módulos portados de OrdenesCompras).
# Dejamos ambos nombres apuntando a lo mismo para que todo el app use una sola base.
DB_SERVER=mysqladelante.database.windows.net
DB_NAME=AdelanteSBX
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_PORT=1433

SQL_SERVER=mysqladelante.database.windows.net
SQL_DATABASE=AdelanteSBX
SQL_USER=tu_usuario
SQL_PASSWORD=tu_password

# ---- Business Central (selectores y empuje de documentos/presupuestos) ----
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Sandbox
BC_COMPANY_ID=
BC_BASE_URL=

# ---- Reporte H4 (API externa) ----
H4_BASE_URL=
H4_API_KEY=

# ---- Twilio (OTP por SMS; opcional en local, el dev-login no lo necesita) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Observabilidad (opcional) ----
# APPLICATIONINSIGHTS_CONNECTION_STRING=
