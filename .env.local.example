# Copiá este archivo a  .env.local  y completá con tus datos reales.
# (.env.local está gitignored — no lo subas.)

# ---- Auth ----
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- SQL Server (Azure) — AdelanteSBX ----
# lib/db.ts acepta DB_* (base) y SQL_* (módulos portados de OrdenesCompras).
# Dejamos ambos nombres apuntando a lo mismo para que todo el app use una sola base.
DB_SERVER=mysqladelante.database.windows.net
DB_NAME=AdelanteSBX
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_PORT=1433

SQL_SERVER=mysqladelante.database.windows.net
SQL_DATABASE=AdelanteSBX
SQL_USER=tu_usuario
SQL_PASSWORD=tu_password

# ---- Grupo B (avance / concreto / utilidades / desembolsos) ----
# Desde 2026-08-04 estos módulos leen de AdelanteSBX: el esquema de AdelanteDB se replicó a
# SBX bajo schemas pro_* (pro_obc/pro_hor/pro_lab/pro_uti/pro_app/pro_bi/pro_ventas) y el SQL
# del app ya apunta ahí. Reusa DB_SERVER/DB_USER/DB_PASSWORD; solo cambia el nombre de base.
ADELANTEDB_NAME=AdelanteSBX
# ADELANTEDB_SERVER=mysqladelante.database.windows.net
# ADELANTEDB_USER=
# ADELANTEDB_PASSWORD=

# ---- Business Central (selectores y empuje de documentos/presupuestos) ----
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Sandbox
BC_COMPANY_ID=
# Compañías ANTERIORES de Business Central (ids separados por coma, opcional).
# Solo LECTURA: si una obra no tiene presupuesto en BC_COMPANY_ID se busca acá.
# En Adelante conviven ADELANTE_DESARROLLOS_NUEVA (la del app) y ADELANTE_DESARROLLOS,
# y hay obras cuyo presupuesto quedó únicamente en la anterior.
BC_COMPANY_IDS_LEGACY=
BC_BASE_URL=

# ---- Reporte H4 (API externa) ----
H4_BASE_URL=
H4_API_KEY=

# ---- Twilio (OTP por SMS; opcional en local, el dev-login no lo necesita) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Observabilidad (opcional) ----
# APPLICATIONINSIGHTS_CONNECTION_STRING=
